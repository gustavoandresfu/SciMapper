{
  "project_metadata": {
    "title": "Mapeo Sistemático de la Literatura: Convergencia Tecnológica y Narrativas Transmedia en Educación",
    "short_name": "SMS_Transmedia_Educacion",
    "authors": [
      "Tesista / Investigador",
      "Director de Tesis"
    ],
    "temporal_window": [
      2021,
      2026
    ],
    "output_dir": "./output_transmedia_edu"
  },
  "research_questions": {
    "RQ1": "¿Cómo se integran las narrativas transmedia y la convergencia tecnológica en las prácticas pedagógicas y los procesos de enseñanza-aprendizaje?",
    "RQ2": "¿Qué competencias mediáticas, digitales y de alfabetismo transmedia (transmedia literacy) se fomentan en estudiantes y docentes?",
    "RQ3": "¿Cuáles son las principales barreras pedagógicas, brechas tecnológicas y desafíos metodológicos documentados en las experiencias educativas transmedia?"
  },
  "search_strategy": {
    "openalex_email": "academic_researcher@universidad.edu",
    "max_results_per_query": 50,
    "queries": [
      "\"transmedia storytelling\" AND \"education\"",
      "\"transmedia\" AND (\"learning\" OR \"pedagogy\")",
      "\"technological convergence\" AND \"education\"",
      "\"transmedia literacy\" AND (\"schools\" OR \"higher education\")",
      "\"participatory culture\" AND (\"education\" OR \"learning\")",
      "\"narrative expansion\" AND (\"transmedia\" OR \"education\")",
      "(\"design\" OR \"planning\" OR \"production\") AND \"multiplatform experience\" AND \"education\"",
      "\"multiplatform\" AND (\"design\" OR \"production\") AND \"transmedia\" AND \"education\"",
      "(\"design\" OR \"production\") AND \"cross-platform experience\" AND (\"education\" OR \"learning\")"
    ]
  },
  "nlp_tuning": {
